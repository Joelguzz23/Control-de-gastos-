function Donut({pct,size=100}) {
  const r=40,cx=50,cy=50,ci=2*Math.PI*r;
  const col=pct>=70?C.success:C.accent;
  const d=ci*(pct/100),g=ci-d;
  return (
    <div style={{position:"relative",width:size,height:size,flexShrink:0}}>
      <svg width={size} height={size} viewBox="0 0 100 100">
        <circle cx={cx} cy={cy} r={r} fill="none" stroke="#1e1e1e" strokeWidth={11}/>
        <circle cx={cx} cy={cy} r={r} fill="none" stroke={col} strokeWidth={11}
          strokeDasharray={`${d} ${g}`} strokeLinecap="round"
          transform={`rotate(-90 ${cx} ${cy})`}/>
      </svg>
      <div style={{position:"absolute",inset:0,display:"flex",alignItems:"center",justifyContent:"center",flexDirection:"column"}}>
        <span style={{fontFamily:"Fraunces,serif",fontSize:size<90?18:20,fontWeight:900,color:col,lineHeight:1}}>{pct}%</span>
        <span style={{fontSize:8,color:C.muted}}>general</span>
      </div>
    </div>
  );
}

// Multiline area chart — solo SVG nativo
function MultiLine({habits,calDates,h=130}) {
  const W=480,pL=6,pR=6,pT=6,pB=14,iW=W-pL-pR,iH=h-pT-pB,n=calDates.length;
  const vis=habits.slice(0,6);
  if(!vis.length) return <Placeholder h={h}/>;
  const xf=i=>pL+(i/Math.max(n-1,1))*iW;
  const yf=v=>pT+iH-(v/100)*iH;
  return (
    <svg viewBox={`0 0 ${W} ${h}`} width="100%" height={h} style={{display:"block"}}>
      <defs>
        {vis.map(hb=>(
          <linearGradient key={hb.id} id={`g${hb.id}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor={hb.color} stopOpacity="0.25"/>
            <stop offset="100%" stopColor={hb.color} stopOpacity="0"/>
          </linearGradient>
        ))}
      </defs>
      <line x1={pL} x2={W-pR} y1={yf(50)} y2={yf(50)} stroke="#1e1e1e" strokeWidth="1"/>
      <line x1={pL} x2={W-pR} y1={yf(100)} y2={yf(100)} stroke="#1e1e1e" strokeWidth="1"/>
      {vis.map(hb=>{
        const days=calDates.map((ds,i)=>({i,v:hb.checks[ds]?100:0}));
        const segs=[];let sg=null;
        days.forEach(({i,v})=>{if(v){if(!sg)sg=[i];else sg.push(i);}else{if(sg){segs.push(sg);sg=null;}}});
        if(sg)segs.push(sg);
        let lp="";let pv=null;
        days.forEach(({i,v})=>{if(v)lp+=pv?` L${xf(i)},${yf(100)}`:`M${xf(i)},${yf(100)}`;pv=v;});
        return (
          <g key={hb.id}>
            {segs.map((s,si)=>{
              const pts=s.map(i=>`${xf(i)},${yf(100)}`).join(" ");
              const bot=[...s].reverse().map(i=>`${xf(i)},${yf(0)}`).join(" ");
              return <polygon key={si} points={`${pts} ${bot}`} fill={`url(#g${hb.id})`}/>;
            })}
            {lp&&<path d={lp} fill="none" stroke={hb.color} strokeWidth="1.8" strokeLinecap="round"/>}
            {days.filter(d=>d.v).map(({i})=><circle key={i} cx={xf(i)} cy={yf(100)} r="2" fill={hb.color}/>)}
          </g>
        );
      })}
      {[0,Math.floor((n-1)/2),n-1].map(i=>(
        <text key={i} x={xf(i)} y={h} textAnchor="middle" fill={C.muted} fontSize="8">{i+1}</text>
      ))}
    </svg>
  );
}

// Barras horizontales por hábito
function HabitBars({habits,pcts,compact}) {
  if(!habits.length) return <Placeholder h={80}/>;
  const items=[...habits.map((h,i)=>({...h,pct:pcts[i]||0}))].sort((a,b)=>b.pct-a.pct).slice(0,7);
  const rh=compact?22:26;
  return (
    <div style={{display:"flex",flexDirection:"column",gap:compact?5:7}}>
      {items.map(it=>(
        <div key={it.id} style={{display:"flex",alignItems:"center",gap:8}}>
          <div style={{width:compact?80:100,flexShrink:0,display:"flex",alignItems:"center",gap:4,overflow:"hidden"}}>
            <span style={{fontSize:compact?12:14,flexShrink:0}}>{it.emoji}</span>
            <span style={{fontSize:compact?9:10,color:C.muted,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap",fontFamily:"Fraunces,serif"}}>{it.name}</span>
          </div>
          <div style={{flex:1,height:rh,background:"#1a1a1a",borderRadius:5,overflow:"hidden"}}>
            <div style={{height:"100%",width:`${it.pct}%`,minWidth:it.pct?3:0,background:it.color,borderRadius:5}}/>
          </div>
          <span style={{width:30,textAlign:"right",fontSize:compact?10:11,fontWeight:700,fontFamily:"Fraunces,serif",color:it.color,flexShrink:0}}>{it.pct}%</span>
        </div>
      ))}
    </div>
  );
}

// Pie SVG
function Pie({slices,size=120}) {
  const ok=slices.filter(s=>s.v>0);
  if(!ok.length) return <Placeholder h={size}/>;
  const tot=ok.reduce((a,s)=>a+s.v,0)||1;
  let a=-Math.PI/2; const cx=50,cy=50,r=43;
  const paths=ok.map(s=>{
    const sw=(s.v/tot)*2*Math.PI;
    const x1=cx+r*Math.cos(a),y1=cy+r*Math.sin(a);
    a+=sw;
    const x2=cx+r*Math.cos(a),y2=cy+r*Math.sin(a);
    return {d:`M${cx},${cy} L${x1},${y1} A${r},${r} 0 ${sw>Math.PI?1:0} 1 ${x2},${y2} Z`,col:s.col};
  });
  return <svg viewBox="0 0 100 100" width={size} height={size}>{paths.map((p,i)=><path key={i} d={p.d} fill={p.col} stroke="#161616" strokeWidth="1"/>)}</svg>;
}

function Placeholder({h=120}) {
  return <div style={{height:h,display:"flex",alignItems:"center",justifyContent:"center",color:C.muted,fontSize:11}}>Sin datos</div>;
}

