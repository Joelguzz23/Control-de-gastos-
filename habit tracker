            <div style={{display:"flex",gap:6}}>
              {[-1,1].map(d=>(
                <button key={d} className="cnav" onClick={()=>navMon(d)}
                  style={{background:"#1e1e1e",border:`1px solid ${C.border}`,borderRadius:7,width:mob?30:34,height:mob?30:34,cursor:"pointer",color:C.text,display:"flex",alignItems:"center",justifyContent:"center",transition:"background .15s"}}>
                  {d<0?<ChevronLeft size={14}/>:<ChevronRight size={14}/>}
                </button>
              ))}
            </div>
          </div>
          {/* Grid días */}
          <div style={{display:"grid",gridTemplateColumns:"repeat(7,1fr)",gap:mob?2:3,marginBottom:3}}>
            {DIAS_S.map(d=><div key={d} style={{textAlign:"center",fontSize:mob?8:10,color:C.muted,padding:"3px 0",fontWeight:600}}>{d}</div>)}
          </div>
          <div style={{display:"grid",gridTemplateColumns:"repeat(7,1fr)",gap:mob?2:3}}>{calCells}</div>
        </div>

        {/* ── ANÁLISIS MENSUAL ──────────────────────────── */}
        <div style={{marginBottom:14}}>
          <div style={{display:"flex",alignItems:"center",gap:7,marginBottom:12}}>
            <BarChart3 size={mob?15:17} color={C.accent}/>
            <span style={{fontFamily:"Fraunces,serif",fontSize:mob?15:19,fontWeight:700}}>Análisis mensual</span>
            <span style={{fontSize:10,color:C.muted}}>{MESES[calM]} {calY}</span>
          </div>

          {/* En móvil: columna única; desktop: 2×2 */}
          <div style={{display:"grid",gridTemplateColumns:mob?"1fr":"1fr 1fr",gap:mob?10:14}}>

            {/* A – Donut + mini barras */}
            <div style={card}>
              <div style={lbl}>Completitud del mes</div>
              <div style={{display:"flex",alignItems:"center",gap:mob?12:18}}>
                <Donut pct={oPct} size={mob?80:100}/>
                <div style={{flex:1,display:"flex",flexDirection:"column",gap:mob?6:8}}>
                  {habits.slice(0,5).map((h,i)=>{
                    const pct=hPcts[i]||0;
                    return (
                      <div key={h.id}>
                        <div style={{display:"flex",justifyContent:"space-between",marginBottom:2}}>
                          <span style={{fontSize:mob?9:10,color:C.text,fontFamily:"Fraunces,serif",overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap",maxWidth:"68%"}}>{h.emoji} {h.name}</span>
                          <span style={{fontSize:mob?9:10,color:h.color,fontWeight:700}}>{pct}%</span>
                        </div>
                        <div style={{height:3,background:"#222",borderRadius:2,overflow:"hidden"}}>
                          <div style={{height:"100%",width:`${pct}%`,background:h.color,borderRadius:2}}/>
                        </div>
                      </div>
                    );
                  })}
                  {!habits.length&&<span style={{color:C.muted,fontSize:11}}>Sin hábitos</span>}
                </div>
              </div>
            </div>

            {/* B – Multi-line */}
            <div style={card}>
              <div style={lbl}>Progreso Diario (%)</div>
              {/* Leyenda mini */}
              <div style={{display:"flex",gap:8,flexWrap:"wrap",marginBottom:8}}>
                {habits.slice(0,6).map(h=>(
                  <div key={h.id} style={{display:"flex",alignItems:"center",gap:3}}>
                    <div style={{width:7,height:7,borderRadius:"50%",background:h.color}}/>
                    <span style={{fontSize:8,color:C.muted,maxWidth:45,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{h.name}</span>
                  </div>
                ))}
              </div>
              <MultiLine habits={habits} calDates={calDts} h={chH}/>
            </div>

            {/* C – Pie */}
            <div style={card}>
              <div style={lbl}>Distribución por hábito</div>
              <div style={{display:"flex",alignItems:"center",gap:mob?10:14}}>
                <Pie slices={pieSlcs} size={mob?90:120}/>
                <div style={{flex:1,display:"flex",flexDirection:"column",gap:mob?4:6}}>
                  {habits.map((h,i)=>(
                    <div key={h.id} style={{display:"flex",alignItems:"center",gap:6}}>
                      <div style={{width:7,height:7,borderRadius:2,background:C.pastel[i%C.pastel.length],flexShrink:0}}/>
                      <span style={{fontSize:mob?9:10,color:C.muted,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap",flex:1}}>{h.emoji} {h.name}</span>
                      <span style={{fontSize:mob?9:10,color:C.text,fontWeight:600,marginLeft:4}}>{hPcts[i]||0}%</span>
                    </div>
                  ))}
                  {!habits.length&&<span style={{color:C.muted,fontSize:10}}>Sin hábitos</span>}
                </div>
              </div>
            </div>

            {/* D – Barras por hábito */}
            <div style={card}>
              <div style={lbl}>Completitud por Hábito (Mes)</div>
              <HabitBars habits={habits} pcts={hPcts} compact={mob}/>
            </div>

          </div>
        </div>

        {/* ── BANNER HOY ───────────────────────────────── */}
        {habits.length>0&&(
          <div style={{...card,marginBottom:14,display:"flex",alignItems:"center",gap:mob?12:18,background:"linear-gradient(135deg,#1a1a1a,#1e1410)"}}>
            <div style={{width:mob?38:48,height:mob?38:48,borderRadius:10,background:"rgba(232,103,58,0.12)",display:"flex",alignItems:"center",justifyContent:"center",flexShrink:0}}>
              <Sparkles size={mob?17:21} color={C.accent}/>
            </div>
            <div style={{flex:1,minWidth:0}}>
              <div style={{display:"flex",justifyContent:"space-between",marginBottom:7}}>
                <span style={{fontFamily:"Fraunces,serif",fontSize:mob?14:17,fontWeight:700}}>Progreso de hoy</span>
                <span style={{fontFamily:"Fraunces,serif",fontSize:mob?14:17,fontWeight:700,color:tdPct>=80?C.success:C.accent}}>{tdDone}/{habits.length}</span>
              </div>
              <div style={{height:5,background:"#222",borderRadius:3,overflow:"hidden"}}>
                <div style={{height:"100%",width:`${tdPct}%`,background:tdPct>=80?C.success:C.accent,borderRadius:3}}/>
              </div>
              <div style={{fontSize:mob?10:11,color:C.muted,marginTop:5}}>
                {tdPct===100?"🎉 ¡Perfecto!":tdPct>=50?`Vas bien · ${habits.length-tdDone} pendiente(s)`:`Empieza fuerte · ${habits.length-tdDone} pendiente(s)`}
              </div>
            </div>
          </div>
        )}

        {/* ── TARJETAS ─────────────────────────────────── */}
        {habits.length===0?(
          <div style={{textAlign:"center",padding:mob?"50px 16px":"70px 20px"}}>
            <div style={{fontSize:mob?40:52,marginBottom:12}}>✦</div>
            <div style={{fontFamily:"Fraunces,serif",fontSize:mob?20:26,fontWeight:700,marginBottom:8}}>Sin hábitos aún</div>
            <div style={{color:C.muted,fontSize:mob?12:14,marginBottom:20}}>Crea tu primer hábito y empieza a construir tu mejor versión.</div>
            <button className="btn-ac" onClick={openNew} style={{display:"inline-flex",alignItems:"center",gap:6,padding:"10px 20px",fontSize:14,borderRadius:8}}>
              <Plus size={15}/> Crear primer hábito
            </button>
          </div>
        ):(
          <div style={{display:"flex",flexDirection:"column",gap:mob?10:14}}>
            {habits.map(h=>{
              const sk=streak(h.checks), bk=bestStreak(h.checks);
              const pct=mPct(h.checks,new Date().getFullYear(),new Date().getMonth());
              const done=!!h.checks[ts];
              return (
                <div key={h.id} className="hcard" style={{...card,transition:"background .2s"}}>
                  {/* Fila top */}
                  <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:mob?10:14}}>
                    <div style={{display:"flex",alignItems:"center",gap:mob?9:12}}>
                      <button onClick={()=>toggle(h.id,ts)}
                        style={{width:mob?34:40,height:mob?34:40,borderRadius:9,border:`2px solid ${done?h.color:C.border}`,background:done?h.color:"transparent",cursor:"pointer",display:"flex",alignItems:"center",justifyContent:"center",flexShrink:0}}>
                        {done?<Check size={mob?14:17} color="#fff" strokeWidth={3}/>:<span style={{fontSize:mob?17:20}}>{h.emoji}</span>}
                      </button>
                      <div>
                        <div style={{fontFamily:"Fraunces,serif",fontSize:mob?14:17,fontWeight:700,color:done?h.color:C.text}}>{h.name}</div>
                        <div style={{fontSize:mob?9:11,color:C.muted,marginTop:1}}>{done?"✓ Completado hoy":"Pendiente hoy"}</div>
                      </div>
                    </div>
                    <div style={{display:"flex",gap:5}}>
                      <button onClick={()=>openEd(h)} style={{background:"#1e1e1e",border:`1px solid ${C.border}`,borderRadius:7,width:mob?26:30,height:mob?26:30,cursor:"pointer",color:C.muted,display:"flex",alignItems:"center",justifyContent:"center"}}>
                        <Edit3 size={mob?11:13}/>
                      </button>
                      <button onClick={()=>del(h.id)} style={{background:"#1e1e1e",border:`1px solid ${C.border}`,borderRadius:7,width:mob?26:30,height:mob?26:30,cursor:"pointer",color:C.muted,display:"flex",alignItems:"center",justifyContent:"center"}}>
                        <Trash2 size={mob?11:13}/>
                      </button>
                    </div>
                  </div>
                  {/* Stats */}
                  <div style={{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:mob?6:10,marginBottom:mob?10:14}}>
                    {[{ic:<Flame size={11} color={C.accent}/>,l:"Racha",v:`${sk}d`},{ic:<Trophy size={11} color="#c4a84a"/>,l:"Récord",v:`${bk}d`},{ic:<TrendingUp size={11} color={C.success}/>,l:"Mes",v:`${pct}%`}].map(({ic,l,v})=>(
                      <div key={l} style={{background:"#1a1a1a",borderRadius:8,padding:mob?"7px 8px":"9px 11px",display:"flex",alignItems:"center",gap:mob?5:7}}>
                        {ic}
                        <div>
                          <div style={{fontSize:mob?8:9,color:C.muted}}>{l}</div>
                          <div style={{fontSize:mob?12:14,fontWeight:700,fontFamily:"Fraunces,serif"}}>{v}</div>
                        </div>
                      </div>
                    ))}
                  </div>
                  {/* Grid 30 días — scroll horizontal */}
                  <div>
                    <div style={{fontSize:mob?9:10,color:C.muted,marginBottom:5}}>Últimos 30 días</div>
                    <div className="sx"><div style={{display:"flex",gap:mob?3:4,flexWrap:"nowrap"}}>{miniGrid(h)}</div></div>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

      {/* ── MODAL ────────────────────────────────────── */}
      {modal&&(
        <div style={{position:"fixed",inset:0,background:"rgba(0,0,0,0.88)",display:"flex",alignItems:mob?"flex-end":"center",justifyContent:"center",zIndex:100,padding:mob?0:16}}
          onClick={e=>e.target===e.currentTarget&&setModal(null)}>
          <div style={{background:"#181818",borderRadius:mob?"18px 18px 0 0":"18px",border:`1px solid ${C.border}`,padding:mob?"20px 16px 28px":"28px",width:"100%",maxWidth:mob?"100%":"430px"}}>
            {mob&&<div style={{width:32,height:4,borderRadius:2,background:C.border,margin:"0 auto 16px"}}/>}
            <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:18}}>
              <span style={{fontFamily:"Fraunces,serif",fontSize:mob?18:22,fontWeight:700}}>{modal.mode==="new"?"Nuevo hábito":"Editar hábito"}</span>
              <button onClick={()=>setModal(null)} style={{background:"transparent",border:"none",cursor:"pointer",color:C.muted}}><X size={18}/></button>
            </div>
            {/* Nombre */}
            <div style={{marginBottom:16}}>
              <label style={{...lbl,display:"block"}}>Nombre</label>
              <input value={form.name} onChange={e=>setForm(f=>({...f,name:e.target.value}))}
                placeholder="Ej: Meditar 10 minutos"
                onKeyDown={e=>e.key==="Enter"&&save()}
                style={{width:"100%",background:"#111",border:`1px solid ${C.border}`,borderRadius:9,padding:"11px 13px",color:C.text,fontSize:14,outline:"none",fontFamily:"Fraunces,serif"}}/>
            </div>
            {/* Emoji */}
            <div style={{marginBottom:16}}>
              <label style={{...lbl,display:"block"}}>Icono</label>
              <div style={{display:"flex",gap:6,flexWrap:"wrap"}}>
                {EMOJIS.map(em=>(
                  <button key={em} onClick={()=>setForm(f=>({...f,emoji:em}))}
                    style={{width:mob?32:36,height:mob?32:36,borderRadius:7,border:`1px solid ${form.emoji===em?C.accent:C.border}`,background:form.emoji===em?"rgba(232,103,58,0.15)":"#111",cursor:"pointer",fontSize:mob?15:17}}>
                    {em}
                  </button>
                ))}
              </div>
            </div>
            {/* Color */}
            <div style={{marginBottom:22}}>
              <label style={{...lbl,display:"block"}}>Color</label>
              <div style={{display:"flex",gap:7,flexWrap:"wrap"}}>
                {C.pastel.map(col=>(
                  <button key={col} onClick={()=>setForm(f=>({...f,color:col}))}
                    style={{width:mob?24:26,height:mob?24:26,borderRadius:5,background:col,border:`2px solid ${form.color===col?"#fff":"transparent"}`,cursor:"pointer"}}/>
                ))}
              </div>
            </div>
            <div style={{display:"flex",gap:8}}>
              <button onClick={()=>setModal(null)} style={{flex:1,background:"#1e1e1e",border:`1px solid ${C.border}`,borderRadius:9,padding:"11px",color:C.text,cursor:"pointer",fontSize:13}}>Cancelar</button>
              <button className="btn-ac" onClick={save} style={{flex:2,borderRadius:9,padding:"11px",fontSize:13}}>{modal.mode==="new"?"Crear hábito":"Guardar"}</button>
            </div>
          </div>
        </div>
      )}

      {/* ── TOAST ────────────────────────────────────── */}
      {toast&&(
        <div style={{position:"fixed",bottom:24,left:"50%",transform:"translateX(-50%)",
          background:toast.ok?"#1a2a1e":"#2a1a1a",
          border:`1px solid ${toast.ok?"#3a5a3a":"#5a3a3a"}`,
          borderRadius:9,padding:"10px 18px",fontSize:12,
          color:toast.ok?C.success:"#e07070",zIndex:300,
          whiteSpace:"nowrap",boxShadow:"0 6px 24px rgba(0,0,0,0.6)",pointerEvents:"none"}}>
          {toast.msg}
        </div>
      )}
    </div>
  );
}
