const C = {
  bg:"#0f0f0f", card:"#161616", border:"#2a2a2a",
  accent:"#e8673a", success:"#6b9e7a", text:"#e8e8e8",
  muted:"#666", faint:"#333",
  pastel:["#a8c5da","#b8d4b8","#e8a89c","#c4b5d4","#e8d5a0","#a0c4c4","#d4a8b8","#b8c4a0"],
};
const EMOJIS = ["🏃","💧","📚","🧘","🍎","💪","😴","✍️","🎵","🧠","🌿","🎯","🚴","🥗","☀️","🎨"];
const MESES  = ["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];
const DIAS_S = ["Do","Lu","Ma","Mi","Ju","Vi","Sá"];
const DIAS_L = ["Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"];

// ── Detección de entorno ──────────────────────────────────
// Detecta app móvil de Claude o viewport estrecho
const IS_CLAUDE_APP = (() => {
  try {
    const ua = navigator.userAgent || "";
    const narrow = window.innerWidth < 768;
    const claudeHints = /Claude|Anthropic/i.test(ua);
    // En la app de Claude el viewport suele ser estrecho y el UA puede incluir hints
    return narrow || claudeHints;
  } catch { return false; }
})();

// ── Utils ─────────────────────────────────────────────────
const fmt    = d => d.toISOString().split("T")[0];
const todayS = () => fmt(new Date());
const dim    = (y,m) => new Date(y,m+1,0).getDate();
const fdow   = (y,m) => new Date(y,m,1).getDay();
const fechaL = () => { const d=new Date(); return `${DIAS_L[d.getDay()]}, ${d.getDate()} de ${MESES[d.getMonth()]} de ${d.getFullYear()}`; };

function streak(checks) {
  let s=0, d=new Date();
  while(checks[fmt(d)]) { s++; d.setDate(d.getDate()-1); }
  return s;
}
function bestStreak(checks) {
  const ds=Object.keys(checks).filter(k=>checks[k]).sort();
  if(!ds.length) return 0;
  let b=1,c=1;
  for(let i=1;i<ds.length;i++){const d=(new Date(ds[i])-new Date(ds[i-1]))/86400000;c=d===1?c+1:1;if(c>b)b=c;}
  return b;
}
function mPct(checks,y,m){
  const t=dim(y,m);
  return t?Math.round(Array.from({length:t},(_,i)=>checks[fmt(new Date(y,m,i+1))]?1:0).reduce((a,b)=>a+b,0)/t*100):0;
}
function dPct(habits,ds){
  return habits.length?Math.round(habits.filter(h=>h.checks[ds]).length/habits.length*100):0;
}

// ── Hook ancho ────────────────────────────────────────────
function useWidth() {
  const [w,setW]=useState(window.innerWidth);
  useEffect(()=>{
    let t; const h=()=>{clearTimeout(t);t=setTimeout(()=>setW(window.innerWidth),80);};
    window.addEventListener("resize",h);
    return()=>window.removeEventListener("resize",h);
  },[]);
  return w;
}

